{
  "name": "diagram",
  "rules": {
    "figure": {
      "fill": "paper",
      "font-family": "font"
    },
    "figure::title": {
      "font-size": 18,
      "font-weight": 600,
      "color": "ink"
    },
    "figure::sub": {
      "font-size": 13,
      "color": "muted"
    },
    "legend": {
      "font-size": 11,
      "color": "muted",
      "stroke": "rule"
    },
    "annotation": {
      "font-size": 13,
      "font-style": "italic",
      "color": "ink",
      "stroke": "soft",
      "fill": "accent"
    },
    "group": {
      "fill": "rule",
      "stroke": "muted",
      "stroke-dasharray": "4 3",
      "border-radius": 10
    },
    "group::title": {
      "font-size": 10,
      "font-weight": 600,
      "color": "muted",
      "text-transform": "uppercase"
    },
    "figure::eyebrow": {
      "font-size": 10,
      "font-weight": 600,
      "color": "muted",
      "text-transform": "uppercase"
    },
    "figure::caption": {
      "font-size": 12,
      "font-style": "italic",
      "color": "muted"
    }
  }
}
