{
  "name": "flow",
  "extends": [
    "diagram"
  ],
  "rules": {
    "node": {
      "fill": "card",
      "stroke": "ink"
    },
    "node:focal": {
      "fill": "accent-tint",
      "stroke": "accent"
    },
    "node[shape=oval]": {
      "border-radius": 20
    },
    "node[shape=dot]": {
      "fill": "ink"
    },
    "node::label": {
      "font-family": "font",
      "font-size": 12,
      "font-weight": 600,
      "color": "ink"
    },
    "node::sub": {
      "font-family": "font-mono",
      "font-size": 9,
      "color": "muted"
    },
    "node::tag": {
      "font-family": "font",
      "font-size": 8
    },
    "edge": {
      "stroke": "muted",
      "stroke-width": 1.8
    },
    "edge:focal": {
      "stroke": "accent"
    },
    "edge[async]": {
      "stroke-dasharray": "5 4"
    },
    "edge::label": {
      "font-family": "font-mono",
      "font-size": 10,
      "color": "muted",
      "text-transform": "uppercase"
    }
  }
}
