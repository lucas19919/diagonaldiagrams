{
  "name": "iso",
  "extends": [
    "diagram"
  ],
  "rules": {
    "group": {
      "fill": "mix(paper, ink, 6%)",
      "stroke": "mix(paper, ink, 32%)",
      "stroke-width": 1
    },
    "group::title": {
      "font-size": 13,
      "font-weight": 600,
      "color": "ink",
      "text-transform": "none",
      "letter-spacing": 0
    },
    "group::sub": {
      "font-size": 11,
      "color": "muted"
    },
    "node": {
      "fill": "card",
      "stroke": "ink",
      "stroke-width": 1.2
    },
    "node:focal": {
      "fill": "mix(card, accent, 10%)",
      "stroke": "accent",
      "stroke-width": 1.6
    },
    "node::label": {
      "font-family": "font",
      "font-size": 12,
      "font-weight": 600,
      "color": "ink"
    },
    "node::sub": {
      "font-family": "font-mono",
      "font-size": 9,
      "color": "muted"
    },
    "edge": {
      "stroke": "muted",
      "stroke-width": 1.6
    },
    "edge:focal": {
      "stroke": "accent"
    },
    "edge[proto^=http]": {
      "stroke": "link"
    },
    "edge[async]": {
      "stroke-dasharray": "5 4"
    },
    "edge::label": {
      "font-family": "font-mono",
      "font-size": 10,
      "color": "muted"
    }
  }
}
