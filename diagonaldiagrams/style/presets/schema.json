{
  "name": "schema",
  "extends": [
    "diagram"
  ],
  "rules": {
    "node": {
      "fill": "card",
      "stroke": "line",
      "stroke-width": 1
    },
    "node:focal": {
      "stroke": "accent"
    },
    "node::label": {
      "font-family": "font",
      "font-size": 13,
      "font-weight": 600,
      "color": "ink"
    },
    "node::tag": {
      "font-family": "font",
      "font-size": 9,
      "font-weight": 600,
      "color": "muted",
      "text-transform": "uppercase",
      "letter-spacing": 0.7
    },
    "edge": {
      "stroke": "link",
      "stroke-width": 1.4
    },
    "edge:focal": {
      "stroke": "accent"
    },
    "edge::label": {
      "font-family": "font",
      "font-size": 11,
      "color": "muted"
    },
    "node::header": {
      "fill": "rgba(45,49,66,0.06)"
    },
    "node:focal::header": {
      "fill": "accent-tint"
    }
  }
}
