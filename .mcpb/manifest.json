{
  "manifest_version": "0.3",
  "name": "diagonaldiagrams",
  "display_name": "diagonaldiagrams",
  "version": "0.9.0",
  "description": "Charts and diagrams for agents: one command checks the spec, draws an SVG, and audits the layout.",
  "author": {
    "name": "Lucas Reimers",
    "url": "https://github.com/lucas19919"
  },
  "homepage": "https://github.com/lucas19919/diagonaldiagrams",
  "repository": {
    "type": "git",
    "url": "https://github.com/lucas19919/diagonaldiagrams"
  },
  "license": "MIT",
  "server": {
    "type": "python",
    "entry_point": "diagonaldiagrams/__main__.py",
    "mcp_config": {
      "command": "python",
      "args": [
        "-m",
        "diagonaldiagrams",
        "mcp"
      ],
      "env": {
        "PYTHONPATH": "${__dirname}"
      }
    }
  }
}
