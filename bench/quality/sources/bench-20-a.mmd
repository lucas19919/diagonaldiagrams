flowchart TD
    start([Request received])
    s1[Load customer account]
    s2[Score fraud risk]
    d3{Check 1 passed?}
    s4[Charge card]
    s5[Write ledger entry]
    s6[Notify warehouse]
    d7{Check 2 passed?}
    s8[Send receipt]
    s9[Update order status]
    s10[Validate request]
    d11{Check 3 passed?}
    s12[Score fraud risk]
    s13[Reserve stock]
    s14[Charge card]
    d15{Check 4 passed?}
    s16[Notify warehouse]
    s17[Print shipping label]
    s18[Send receipt]
    done([Done])

    start --> s1 --> s2 --> d3
    d3 -->|yes| s4
    d3 -->|no| s1
    s4 --> s5 --> s6 --> d7
    d7 -->|yes| s8
    d7 -->|no| s10
    s8 --> s9 --> s10 --> d11
    d11 -->|yes| s12
    d11 -->|no| s9
    s12 --> s13 --> s14 --> d15
    d15 -->|yes| s16
    d15 -->|no| s18
    s16 --> s17 --> s18 --> done
