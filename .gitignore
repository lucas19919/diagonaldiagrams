# Python runtime & bytecode
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# Virtual environments
.venv/
env/
venv/
ENV/
env.bak/
venv.bak/

# Packaging & distribution
build/
dist/
wheels/
!docs/wheels/
*.egg-info/
.eggs/
*.egg

# Testing & coverage
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/

# Rendered output
out/

# Node, for tests/pyodide_smoke.mjs
node_modules/

# Git worktrees
.worktrees/

# IDE & Editor configs
.vscode/
!.vscode/settings.json
.idea/
*.swp
*.swo
*~

# AI agent local runtime state & transients
.claude/
.cursor/
.gemini/
*.log

# Benchmarks & raw profiling traces (example CSVs stay tracked).
# Saved scoreboard metrics (bench/metrics/NAME.json/.md) are tracked; latest.* is a scratch run.
bench/*
!bench/metrics/
bench/metrics/latest.*
# The tool comparison (scripts/bench_speed.py, scripts/bench_prompts.py): inputs, prompts and saved results.
!bench/speed/
bench/speed/latest.*
!bench/tokens/

# Context System: Transient scratchpads, session notes & logs
# (Tier 3: Ignored transient state; Tier 2 specs/ADRs in context/ remain tracked)
context/scratch/*
!context/scratch/.gitkeep
context/private/
context/bench/
context/logs/
context/*.local.*
.context/
/scratch/

# OS metadata
.DS_Store
Thumbs.db
Desktop.ini
